{
  "provider": "gcp",
  "key": {
    "name": "gcp_noveldag_rsa",
    "path": "/root/.ssh/gcp_noveldag_rsa",
    "user": "ubuntu"
  },
  "port": 5000,
  "repo": {
    "name": "NovelDAG",
    "url": "https://github.com/TH-Chou/NovelDAG.git",
    "branch": "icde_shortfin_archive"
  },
  "instances": {
    "name": "noveldag-node",
    "type": "n2-standard-2",
    "project": "shortfin",
    "zones": [
      "asia-east1-a",
      "asia-southeast1-a",
      "us-east1-b",
      "us-west1-a",
      "europe-west1-b"
    ],
    "network": "default",
    "subnetwork": "",
    "firewall_rule": "noveldag-benchmark",
    "image_project": "shortfin",
    "image_family": "shortfin-noveldag-25gb",
    "disk_size_gb": 25,
    "ssh_user": "ubuntu"
  }
}
